# Required when API-key protection should be enabled.
# Replace this value with a long random key.
OCR_API_KEY=CHANGE_ME_LONG_RANDOM_KEY

# Port exposed on the Docker host.
OCR_HOST_PORT=9080

# Maximum upload size in megabytes.
OCR_MAX_FILE_MB=20

# Rendering resolution for the first page of PDF documents.
OCR_PDF_DPI=200

# Python logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
OCR_LOG_LEVEL=INFO

{
  "schema": 1,
  "profile_id": "shell_recharge_ch_receipt_v1",
  "name": "Shell Recharge Schweiz Beleg",
  "version": "1.0",
  "country": "CH",
  "status": "tested",
  "tested_with_real_receipt": true,
  "priority": 110,
  "match_threshold": 0.75,
  "match": {
    "required_contains": [
      "Shell (Switzerland) AG",
      "Transaktionsbeleg"
    ],
    "optional_contains": [
      "Shell Recharge",
      "Ladepunkt-ID (EVSE ID)",
      "Geladene Energie",
      "Gesamtbetrag"
    ]
  },
  "fields": {
    "merchant": {
      "method": "fixed",
      "value": "Shell Recharge"
    },
    "provider": {
      "method": "fixed",
      "value": "Shell Recharge"
    },
    "billing_platform": {
      "method": "fixed",
      "value": "Shell Recharge"
    },
    "invoice_number": {
      "patterns": [
        "Beleg-Nr\\.\\s*([A-Z0-9-]+)"
      ],
      "transform": [
        "strip",
        "remove_whitespace"
      ]
    },
    "receipt_date": {
      "patterns": [
        "Ausstellungsdatum:\\s*(\\d{2}/\\d{2}/\\d{4})"
      ],
      "transform": "date_slash_dmy4"
    },
    "charging_start": {
      "patterns": [
        "Beginn:\\s*(\\d{2}/\\d{2}/\\d{4}\\s+\\d{2}:\\d{2})"
      ],
      "transform": "datetime_slash_dmy4_at",
      "required": true
    },
    "charging_end": {
      "patterns": [
        "Ende:\\s*(\\d{2}/\\d{2}/\\d{4}\\s+\\d{2}:\\d{2})"
      ],
      "transform": "datetime_slash_dmy4_at"
    },
    "duration_seconds": {
      "patterns": [
        "Dauer:\\s*(\\d{1,2}:\\d{2}:\\d{2})"
      ],
      "transform": "duration_hhmmss"
    },
    "energy_kwh": {
      "patterns": [
        "Geladene Energie:\\s*([\\d.,]+)\\s*kWh"
      ],
      "transform": "decimal",
      "required": true
    },
    "price_per_kwh": {
      "patterns": [
        "Preis pro kWh:\\s*([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "session_fee": {
      "patterns": [
        "Transaktionsgebühr:\\s*([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "subtotal": {
      "patterns": [
        "Betrag exkl\\.\\s*MwSt\\s*([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "energy_cost_net": {
      "patterns": [
        "Energiekosten\\s*([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "session_fee_net": {
      "patterns": [
        "Energiekosten\\s*[\\d.,]+\\s*CHF\\s*\\nTransaktionsgebühr\\s*([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "vat": {
      "patterns": [
        "MwSt\\s*\\([\\d.,]+%\\)\\s*([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "total": {
      "patterns": [
        "Gesamtbetrag\\s*([\\d.,]+)\\s*CHF",
        "Bezahlter Betrag\\s*([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal",
      "required": true
    },
    "currency": {
      "method": "fixed",
      "value": "CHF"
    },
    "station": {
      "patterns": [
        "Transaktionsgebühr:\\s*[\\d.,]+\\s*CHF\\s*\\n([^\\n]+)\\s*\\n[^\\n]+\\s*\\n[^\\n]+\\s*\\nCH\\b"
      ],
      "transform": [
        "strip",
        "collapse_whitespace"
      ],
      "required": true
    },
    "address_street": {
      "patterns": [
        "Transaktionsgebühr:\\s*[\\d.,]+\\s*CHF\\s*\\n[^\\n]+\\s*\\n([^\\n]+)"
      ],
      "transform": [
        "strip",
        "collapse_whitespace"
      ]
    },
    "city": {
      "patterns": [
        "Transaktionsgebühr:\\s*[\\d.,]+\\s*CHF\\s*\\n[^\\n]+\\s*\\n[^\\n]+\\s*\\n([^\\n]+)\\s*\\nCH\\b"
      ],
      "transform": [
        "strip",
        "collapse_whitespace"
      ]
    },
    "country": {
      "method": "fixed",
      "value": "CH"
    },
    "evse_id": {
      "patterns": [
        "Ladepunkt-ID\\s*\\(EVSE ID\\)\\s*([A-Z0-9*_-]+)"
      ],
      "transform": [
        "strip",
        "remove_whitespace",
        "upper"
      ]
    },
    "payment_method": {
      "patterns": [
        "Zahlungsmethode\\s*([^\\n]+)"
      ],
      "transform": [
        "strip",
        "collapse_whitespace"
      ]
    },
    "payment_date": {
      "patterns": [
        "Zahlungsdatum\\s*(\\d{2}/\\d{2}/\\d{4})"
      ],
      "transform": "date_slash_dmy4"
    }
  },
  "derived_fields": {
    "station_address": {
      "method": "format_fields",
      "template": "{address_street}, {city}, {country}"
    }
  }
}

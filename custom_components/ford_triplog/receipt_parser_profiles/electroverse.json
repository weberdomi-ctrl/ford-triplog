{
  "schema": 1,
  "profile_id": "electroverse_receipt_v1",
  "name": "Octopus Electroverse Beleg",
  "version": "1.3",
  "country": "CH",
  "status": "tested",
  "tested_with_real_receipt": true,
  "priority": 500,
  "match_threshold": 0.75,
  "match": {
    "required_contains": [
      "ELECTROVERSE",
      "EVSE"
    ],
    "optional_contains": []
  },
  "fields": {
    "merchant": {
      "method": "fixed",
      "value": "Octopus Electroverse"
    },
    "billing_platform": {
      "method": "fixed",
      "value": "Octopus Electroverse"
    },
    "provider": {
      "patterns": [
        "(?:Provider|Anbieter)\\s+([^\\r\\n]+)"
      ],
      "transform": [
        "strip",
        "collapse_whitespace"
      ]
    },
    "receipt_date": {
      "patterns": [
        "(?:Receipt Date|Belegdatum):?\\s*(\\d{1,2}(?:st|nd|rd|th)?\\s+[A-Za-zÄÖÜäöüß.]+\\s+\\d{4})"
      ],
      "transform": [
        "strip",
        "collapse_whitespace"
      ]
    },
    "invoice_number": {
      "patterns": [
        "(?:Receipt|Beleg)\\s+(\\d+)"
      ],
      "transform": [
        "strip",
        "remove_whitespace"
      ]
    },
    "evse_id": {
      "patterns": [
        "EVSE\\s+([A-Z0-9*_.:-]+)"
      ],
      "transform": [
        "strip",
        "remove_whitespace"
      ]
    },
    "charging_start": {
      "patterns": [
        "(?:Session start|Start des Ladevorgangs)\\s+(\\d{1,2}(?:st|nd|rd|th)?\\s+[A-Za-zÄÖÜäöüß.]+\\s+\\d{4}\\s+\\d{2}:\\d{2}:\\d{2})"
      ],
      "transform": "datetime_ordinal_month",
      "required": true
    },
    "charging_end": {
      "patterns": [
        "(?:Session end|Ende des Ladevorgangs)\\s+(\\d{1,2}(?:st|nd|rd|th)?\\s+[A-Za-zÄÖÜäöüß.]+\\s+\\d{4}\\s+\\d{2}:\\d{2}:\\d{2})"
      ],
      "transform": "datetime_ordinal_month"
    },
    "energy_kwh": {
      "patterns": [
        "(?:Consumption|Verbrauch)\\s*\\[kWh\\]\\s+([\\d.,]+)\\s*CHF\\s+([\\d.,]+)"
      ],
      "group": 2,
      "transform": "decimal",
      "required": true
    },
    "price_per_kwh": {
      "patterns": [
        "(?:Consumption|Verbrauch)\\s*\\[kWh\\]\\s+([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "subtotal": {
      "patterns": [
        "(?:Total|Gesamt)\\s+([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "vat": {
      "patterns": [
        "(?:Total|Gesamt)\\s+[\\d.,]+\\s*CHF\\s+([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "gross_total": {
      "patterns": [
        "(?:Total|Gesamt)\\s+[\\d.,]+\\s*CHF\\s+[\\d.,]+\\s*CHF\\s+([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "credit_applied": {
      "patterns": [
        "Credit Applied\\s+CHF\\s*([\\d.,]+)",
        "Angewandtes Guthaben\\s+([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "amount_payable": {
      "patterns": [
        "Amount payable\\s+CHF\\s*([\\d.,]+)",
        "Zu zahlender Betrag\\s+([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal",
      "required": true
    },
    "payable_after_credit": {
      "patterns": [
        "Payable After Credit\\s+CHF\\s*([\\d.,]+)",
        "Zahlbar nach Gutschrift\\s+([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "total": {
      "patterns": [
        "Amount payable\\s+CHF\\s*([\\d.,]+)",
        "Zu zahlender Betrag\\s+([\\d.,]+)\\s*CHF"
      ],
      "transform": "decimal"
    },
    "currency": {
      "method": "fixed",
      "value": "CHF"
    },
    "co2_saved_kg": {
      "patterns": [
        "Est\\.\\s*C0?O?2\\s*saved\\s*([\\d.,]+)\\s*kg",
        "Geschätzte\\s+CO2-Einsparung\\s*([\\d.,]+)\\s*kg"
      ],
      "transform": "decimal"
    },
    "address_street": {
      "patterns": [
        "(?:Address|Adresse)\\s+([^\\r\\n]+)"
      ],
      "transform": [
        "strip",
        "collapse_whitespace"
      ]
    },
    "city": {
      "patterns": [
        "(?:Session end|Ende des Ladevorgangs)\\s+\\d{1,2}(?:st|nd|rd|th)?\\s+[A-Za-zÄÖÜäöüß.]+\\s+\\d{4}\\s+\\d{2}:\\d{2}:\\d{2}\\s+([^\\r\\n]+)"
      ],
      "transform": [
        "strip",
        "collapse_whitespace"
      ]
    },
    "postal_code": {
      "patterns": [
        "\\b(\\d{4}),\\s*CHE\\b"
      ],
      "transform": "integer"
    },
    "country": {
      "method": "fixed",
      "value": "CHE"
    }
  },
  "derived_fields": {
    "station": {
      "method": "format_fields",
      "template": "{address_street}, {postal_code} {city}, {country}"
    }
  }
}
